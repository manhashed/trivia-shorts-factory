# Copy this file to `.env` in the repo root, then fill in only the keys you use.
# Never commit `.env`. Restart the backend after changing values.

# Audience-facing product is built for children ages 5–8 (early elementary).

# ---------------------------------------------------------------------------
# Voice engine
# ---------------------------------------------------------------------------
# edge        = Microsoft Edge Neural TTS (free, no key, default)
# openai      = OpenAI TTS (needs OPENAI_API_KEY)
# elevenlabs  = ElevenLabs (needs ELEVENLABS_API_KEY)
TTS_PROVIDER=edge

# Must match the provider you selected:
#   edge        → en-US-AnaNeural (recommended for 5–8)
#                 en-US-JennyNeural, en-US-GuyNeural, en-GB-SoniaNeural, ...
#   openai      → nova, fable, alloy, shimmer, echo
#   elevenlabs  → 21m00Tcm4TlvDq8ikWAM (Rachel), EXAVITQu4vr4xnSDxMaL (Bella), ...
TTS_VOICE=en-US-AnaNeural
TTS_RATE=+0%
TTS_PITCH=+0Hz

# ---------------------------------------------------------------------------
# OpenAI TTS (or any OpenAI-compatible /v1/audio/speech endpoint)
# Get a key: https://platform.openai.com/api-keys
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_TTS_MODEL=tts-1
# Leave as-is for OpenAI. Point this at a compatible speech API if you use one
# (Groq, a local proxy, etc.). Must expose POST {base}/audio/speech.
OPENAI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# ElevenLabs
# Get a key: https://elevenlabs.io/app/settings/api-keys
# ---------------------------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
